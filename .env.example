PLATFORM_URL=http://127.0.0.1:8080
BOT_TOKEN=
TRAINING_SERVICE_KEY=

# The time zone for dates until a trainer has opened the cabinet in a browser, e.g. Europe/Samara
# BOT_DEFAULT_TIME_ZONE=
# A private-network platform address without TLS, such as http://backend:8080 in Docker Compose
# PLATFORM_ALLOW_INSECURE=true
# All other settings and their defaults are listed in src/main/resources/bot.conf
